# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=code_analyzer
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=ca_secret          # CHANGE IN PRODUCTION

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ca_user:ca_secret@localhost:5432/code_analyzer
UPLOAD_DIR=/tmp/ca_uploads
MAX_UPLOAD_SIZE_MB=200
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# ── Python Worker ──────────────────────────────────────────────────────────
RESULTS_DIR=/tmp/ca_results
WORKER_CONCURRENCY=3
